# ==========================================
# GIZMOTEK.LK ENVIRONMENT VARIABLES TEMPLATE
# ==========================================

# 1. Supabase PostgreSQL Connection Strings
# Replace [YOUR-PASSWORD] with your actual Supabase database password
DATABASE_URL="postgresql://postgres.gewwpowjurlsvjehysyp:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.gewwpowjurlsvjehysyp:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# 2. Store Domain & URL
NEXT_PUBLIC_SITE_URL="https://gizmotek.lk"
# Public base URL used for PayHere return/notify URLs (defaults to NEXT_PUBLIC_SITE_URL)
APP_URL="https://gizmotek.lk"
# Optional: extra origins allowed to call the API with credentials (comma-separated)
# ALLOWED_ORIGINS="https://www.gizmotek.lk"

# 3. Admin Security Credentials (REQUIRED in production — admin login is disabled without ADMIN_PASSWORD)
# Use a long, unique password. Never reuse the old default from earlier versions of this file.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me-to-a-long-random-password"
# Secret used to sign admin session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it logs out every admin session. (ADMIN_SESSION_TOKEN is still accepted as a fallback.)
ADMIN_SESSION_SECRET="replace-with-64-random-hex-characters"

# 4. PayHere Sri Lanka Payment Gateway Settings
# Set to "true" once PayHere merchant approval is complete (Pending review 5-10 business days)
VITE_ENABLE_CARD_PAYMENT="false"
ENABLE_CARD_PAYMENT="false"
# Obtain live Merchant ID & Secret from https://www.payhere.lk (required in production when card payments are enabled)
PAYHERE_MERCHANT_ID="your_payhere_merchant_id"
PAYHERE_MERCHANT_SECRET="your_payhere_merchant_secret"
PAYHERE_MODE="sandbox" # "sandbox" for testing, "live" for production real sales


RESEND_API_KEY="re_xxxxxxxxxxxxxx"
ADMIN_NOTIFICATION_EMAIL="orders@gizmotek.lk"
MAIL_FROM="GizmoTek Store <orders@gizmotek.lk>"

# 5. Web3Forms Contact Form Access Key
# Get a free access key instantly at https://web3forms.com
VITE_WEB3FORMS_ACCESS_KEY="your_web3forms_access_key_here"
