datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Product {
  id              String      @id @default(uuid())
  title           String
  slug            String      @unique
  description     String
  category        String
  sellingPriceLkr Float
  costPriceLkr    Float
  sku             String      @unique
  stock           Int         @default(10)
  images          String      // JSON string array of image URLs
  specs           String?     // JSON string key-value object
  supplierLink    String?
  supplierNotes   String?
  isFeatured      Boolean     @default(false)
  isBestSeller    Boolean     @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  orderItems      OrderItem[]
}

model Order {
  id               String      @id @default(uuid())
  orderNumber      String      @unique
  customerName     String
  customerPhone    String
  customerEmail    String?
  address          String
  district         String
  city             String
  paymentMethod    String      // "COD" | "BANK_TRANSFER" | "CARD"
  paymentStatus    String      // "PENDING" | "VERIFIED" | "PAID" | "FAILED"
  orderStatus      String      // "PENDING" | "PROCESSING" | "SHIPPED" | "DELIVERED" | "CANCELLED"
  bankSlipUrl      String?
  subtotalLkr      Float
  shippingFeeLkr   Float
  totalLkr         Float
  notes            String?
  items            OrderItem[]
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

model OrderItem {
  id         String   @id @default(uuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  quantity   Int
  unitPrice  Float
}
