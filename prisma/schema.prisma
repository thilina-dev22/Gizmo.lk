datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

model Product {
  id              String      @id @default(uuid())
  title           String
  slug            String      @unique
  description     String
  category        String
  sellingPriceLkr Float
  costPriceLkr    Float
  sku             String      @unique
  stock           Int         @default(10)
  images          String      // JSON string array of image URLs
  specs           String?     // JSON string key-value object
  supplierLink    String?
  supplierNotes   String?
  isFeatured      Boolean     @default(false)
  isBestSeller    Boolean     @default(false)
  rating          Float       @default(0)
  reviewCount     Int         @default(0)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  orderItems      OrderItem[]
  reviews         Review[]
}

model Review {
  id          String   @id @default(uuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  authorName  String
  rating      Int      @default(5)
  comment     String
  isApproved  Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Order {
  id               String      @id @default(uuid())
  orderNumber      String      @unique
  customerName     String
  customerPhone    String
  customerEmail    String?
  address          String
  district         String
  city             String
  paymentMethod    String      // "COD" | "BANK_TRANSFER" | "CARD"
  paymentStatus    String      // "PENDING" | "VERIFIED" | "PAID" | "FAILED"
  orderStatus      String      // "PENDING" | "PROCESSING" | "SHIPPED" | "DELIVERED" | "CANCELLED"
  bankSlipUrl      String?
  subtotalLkr      Float
  shippingFeeLkr   Float
  totalLkr         Float
  notes            String?
  items            OrderItem[]
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

model OrderItem {
  id         String   @id @default(uuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  quantity   Int
  unitPrice  Float
}
